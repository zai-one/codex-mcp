# HTTP transport settings for codex-app-mcp
# Copy outside the repo and fill in. Never commit real tokens.
# Unofficial community project — not an official OpenAI/Codex product.
# Bearer is an operator-generated secret — NOT OpenAI/Codex OAuth.

CODEX_APP_MCP_TRANSPORT=http
CODEX_APP_MCP_HTTP_HOST=127.0.0.1
CODEX_APP_MCP_HTTP_PORT=8765

# Generate: openssl rand -hex 32 > /path/to/codex-app-mcp.token
# Set only ONE of CODEX_APP_MCP_HTTP_TOKEN or CODEX_APP_MCP_HTTP_TOKEN_FILE.
# CODEX_APP_MCP_HTTP_TOKEN=
CODEX_APP_MCP_HTTP_TOKEN_FILE=<TOKEN_FILE>

# Optional browser Origin allowlist (exact match, semicolon-separated)
# CODEX_APP_MCP_HTTP_ALLOWED_ORIGINS=https://example.invalid

CODEX_APP_MCP_HTTP_MAX_INFLIGHT=16
CODEX_APP_MCP_ALLOWED_ROOTS=<PROJECT_ROOT>
CODEX_APP_MCP_ECONOMY=1
