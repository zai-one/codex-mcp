# Non-secret defaults for local codex-app-mcp development.
# Copy to .env (gitignored) if your tooling loads dotenv.
# Do NOT put API keys, OAuth tokens, or HTTP bearers here.

# Codex binary that provides app-server
CODEX_APP_MCP_BIN=codex

# Transport: stdio (default) or http
CODEX_APP_MCP_TRANSPORT=stdio

# Project roots fail closed when empty (semicolon-separated or JSON array)
CODEX_APP_MCP_ALLOWED_ROOTS=/path/to/allowed/project

# Capability gates (leave off unless deliberately required)
CODEX_APP_MCP_ALLOW_FULL_ACCESS=0
CODEX_APP_MCP_ALLOW_UNSAFE_RPC=0
# CODEX_APP_MCP_ALLOWED_RPC_METHODS=thread/delete

# Optional defaults for sandbox / approvals
# CODEX_APP_MCP_DEFAULT_SANDBOX=workspace-write
# CODEX_APP_MCP_DEFAULT_APPROVAL_POLICY=on-request

# Timeouts (seconds)
CODEX_APP_MCP_REQUEST_TIMEOUT_SECONDS=30
CODEX_APP_MCP_OPERATION_TIMEOUT_SECONDS=180
CODEX_APP_MCP_ACTION_TIMEOUT_SECONDS=60

# Audit (secret-safe metadata only)
CODEX_APP_MCP_AUDIT=1
CODEX_APP_MCP_PRINCIPAL=local

# Scheduler
CODEX_APP_MCP_SCHEDULER_ENABLED=1
CODEX_APP_MCP_SCHEDULER_POLL_SECONDS=1

# HTTP bind defaults (use examples/http.env.example for bearer settings)
CODEX_APP_MCP_HTTP_HOST=127.0.0.1
CODEX_APP_MCP_HTTP_PORT=8765
CODEX_APP_MCP_HTTP_MAX_INFLIGHT=16
